@import "tailwindcss";

:root {
  --background: #ffffff;
  --foreground: #0a0a0a;
  --ink: #0a0a0a;
  --paper: #ffffff;
  --plate: #f4f4f4;
  --hairline: #d9d9d9;
  --muted: #6b6b6b;
  --accent: #0fd3b8;
}

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-ink: var(--ink);
  --color-paper: var(--paper);
  --color-plate: var(--plate);
  --color-hairline: var(--hairline);
  --color-muted: var(--muted);
  --color-accent: var(--accent);
  --font-display: var(--font-display);
  --font-sans: var(--font-sans);
  --font-mono: var(--font-mono);
}

html {
  scroll-behavior: smooth;
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }
  *,
  *::before,
  *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
  }
}

body {
  background: var(--paper);
  color: var(--ink);
  font-family: var(--font-sans);
}

/* -- signature: hairline column rule that runs the whole page -- */
.page-rule {
  position: relative;
}
.page-rule::before {
  content: "";
  position: absolute;
  top: 0;
  bottom: 0;
  left: max(1.5rem, calc(50% - 40rem));
  width: 1px;
  background: var(--hairline);
}

/* -- metered focus, visible keyboard-only -- */
:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 3px;
}

/* faint loading shimmer for the hero plate before image resolves */
@keyframes plate-in {
  from {
    opacity: 0;
    transform: scale(1.02);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}
.hero-plate {
  animation: plate-in 900ms ease-out both;
}
